# 이 파일을 .env 로 복사한 뒤 값을 채우세요 (.env 는 git 에 올라가지 않음)

# Neon 콘솔 > Connect 에서 복사한 연결 문자열. 서버(server/)에서만 사용, 절대 VITE_ 를 붙이지 말 것
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Neon 콘솔 > Auth > Configuration 의 Auth URL. 공개돼도 되는 값이라 브라우저와 서버가 같이 사용
VITE_NEON_AUTH_URL=https://ep-xxxx.neonauth.ap-southeast-1.aws.neon.build/neondb/auth

# API 서버 포트 (vite.config.js 의 /api 프록시와 같아야 함)
PORT=3001
