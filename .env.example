# 이 파일을 복사해 .env 로 만들고 값을 채우세요. .env 는 git에 올라가지 않음

# Neon 콘솔 > Connection string
DATABASE_URL=
NEON_API_KEY=
# Neon 콘솔 > Auth > Configuration 의 Auth URL
VITE_NEON_AUTH_URL=
PORT=3001

# 문자 인증 (Solapi)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# 사진 저장소 (Cloudflare R2). 비워 두면 서버는 뜨지만 사진 올리기만 안 됨
# R2 > Overview 오른쪽의 Account ID
R2_ACCOUNT_ID=
# R2 > Manage API tokens 에서 "Object Read & Write" 토큰을 만들면 나오는 두 값
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 만든 버킷 이름
R2_BUCKET=
# 버킷 > Settings > Public Development URL (https://pub-xxxx.r2.dev) 또는 연결한 도메인
R2_PUBLIC_URL=
